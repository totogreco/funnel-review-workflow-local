# Manual funnel review: settings. Copy to .env and fill in. Never commit .env.
# No OpenRouter and no AI API keys: Claude Code does the review on your own Claude account.
# Onboarding (skills/onboarding) fills these in with you, one step at a time.

# --- Google Sheet (read-only) --------------------------------------------------
# The spreadsheet that holds the FUNNEL-BUILDING tab: the part of its link between /d/ and /edit.
FUNNEL_SHEET_ID=
FUNNEL_SHEET_TAB=FUNNEL-BUILDING

# Google sign-in. Ask the owner for the team's Google OAuth client (Desktop app):
# paste both values below, OR put the downloaded JSON in this folder as credentials.json.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the sign-in result is saved (created by tools/google_auth.py).
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CLIENT_SECRET_PATH=credentials.json

# --- Publishing to the team's Render site ----------------------------------------
# Every reviewer publishes to the same site. The token comes from the owner (password manager).
PUBLIC_BASE_URL=https://ad-translation.onrender.com
FEEDBACK_UPLOAD_TOKEN=
