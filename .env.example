# Manual funnel review: settings. Copy to .env and fill in. Never commit .env.
# No OpenRouter and no AI API keys: Claude Code does the review on your own Claude account.
# Onboarding (skills/onboarding) fills these in with you, one step at a time.

# --- Google Sheet (read-only) --------------------------------------------------
# The work sheet (the spreadsheet with the FUNNEL-BUILDING tab): the part of its link between /d/ and /edit.
FUNNEL_SHEET_ID=
FUNNEL_SHEET_TAB=FUNNEL-BUILDING

# Google sign-in: your OWN Google Cloud OAuth client (Desktop app), created during onboarding.
# Default: its downloaded JSON saved in this folder as credentials.json (leave the two lines below empty).
# Alternative: paste the client ID and secret of that same client below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the sign-in result is saved (created by tools/google_auth.py).
GOOGLE_TOKEN_PATH=token.json
GOOGLE_CLIENT_SECRET_PATH=credentials.json

# --- Publishing to the team's Render site ----------------------------------------
# Every reviewer publishes to the same site. The funnel feedback token comes from the owner (password manager).
PUBLIC_BASE_URL=https://ad-translation.onrender.com
FEEDBACK_UPLOAD_TOKEN=
